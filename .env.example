# ==============================================================
# TuneWave Music Streaming Platform — Environment Configuration
# Use placeholders only. Never commit real credentials.
# ==============================================================

# Backend Database (PostgreSQL / Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://your-db-host:5432/your-db-name
SPRING_DATASOURCE_USERNAME=your_database_user
SPRING_DATASOURCE_PASSWORD=your_database_password

# Backend JWT Authentication
TUNEWAVE_JWT_SECRET=your_base64_or_hex_encoded_jwt_secret_key_at_least_256_bits
TUNEWAVE_JWT_EXPIRATION_MS=86400000

# Backend Supabase Integration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your_supabase_anon_key

# Frontend Environment Variables (Vite prefixed)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key
VITE_API_BASE_URL=http://localhost:8080/api
